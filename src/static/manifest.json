{
  "manifest_version": 3,
  "name": "Meet Music",
  "version": "0.1.0",
  "description": "Shared music queue inside Google Meet. Paste a YouTube link and the whole meeting hears it, without anyone else installing a thing.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Meet Music",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "mic-patch.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "yt-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "yt-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
